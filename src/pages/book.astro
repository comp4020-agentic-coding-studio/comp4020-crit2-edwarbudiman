  .confirm-list__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-3);
    border-bottom: var(--hairline) solid var(--color-rule);
