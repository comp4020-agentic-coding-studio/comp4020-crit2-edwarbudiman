---
/*
 * A registration target, drawn as geometry.
 *
 * On a press sheet this is where the separate colour plates must line up; it
 * is the mark that proves the sheet is in register. Here it does the
 * equivalent job for the page: it anchors a section, marking the point two
 * things align on. It is quoted from page 1 of Inari's menu PDF, which
 * carries eight of them around its edges.
 *
 * Decorative-only use is not allowed (CLAUDE.md) — if it is not anchoring
 * something, leave it out.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 18, class: className } = Astro.props;
---

<svg
  class:list={["reg-mark", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="12" cy="12" r="6.25" stroke="currentColor" stroke-width="1"></circle>
  <path d="M12 0v7.5M12 16.5V24M0 12h7.5M16.5 12H24" stroke="currentColor" stroke-width="1"
  ></path>
</svg>

<style>
  .reg-mark {
    color: var(--color-rule-strong);
    flex: none;
  }
</style>
