  }

  .docket__mark {
    margin-top: 0.35rem;
  }

  .docket__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin: 0;
  }

  .docket__cell {
    display: grid;
    gap: 0.1rem;
  }

  .docket__cell dt {
    font-family: var(--font-mono);
    font-size: var(--text-furniture);
    letter-spacing: var(--tracking-furniture);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .docket__cell dd {
    margin: 0;
    font-size: 1.125rem;
    color: var(--color-ink);
  }

  /* ---- Submit ------------------------------------------------------------- */

  .submit-row {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-6);
    justify-items: start;
  }

  .form-alert {
    font-weight: 600;
    color: var(--color-red);
    max-width: 52ch;
  }

  .form-alert:empty {
    display: none;
  }

  .submit-note {
    font-size: 0.875rem;
    color: var(--color-ink-muted);
    max-width: 48ch;
  }

  /* At 390px the sheet's own padding leaves the large button too little room
     for its label, and a two-line button reads as an accident. Tighten the
     horizontal padding rather than shorten the label — "prototype only" is
     the part that has to survive. */
  @media (width <= 30rem) {
    .submit-row .btn {
      padding-inline: var(--space-5);
    }
  }

  /* ---- The proof ---------------------------------------------------------- */

  .book-confirm {
    padding: clamp(var(--space-5), 3.5vw, var(--space-8));
    border-radius: var(--radius);
    background: var(--color-cream);
  }

  .book-confirm[hidden] {
    display: none;
  }

  .book-confirm:not([hidden]) {
    display: grid;
    gap: var(--space-5);
    justify-items: start;

    /* The one authored motion moment on this page: the slip settles onto the
       sheet. Transform only — the text is fully legible from the first
       frame, so nothing depends on the animation running. Reduced motion is
       handled globally in global.css. */
    animation: proof-settle var(--dur) var(--ease-out) both;
  }

  @keyframes proof-settle {
    from {
      transform: translateY(0.5rem);
    }

    to {
      transform: translateY(0);
    }
  }

  /* A proof stamp: the mark a press proof carries so it can never be
     mistaken for the final sheet. Which is precisely this page's problem. */
  .stamp {
    margin: 0;
    transform: rotate(-1.5deg);
  }

  .stamp__text {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border: var(--hairline) solid var(--color-red);
    border-radius: var(--radius-sm);
    color: var(--color-red);
  }

  .confirm-list {
    display: grid;
    gap: 0;
    margin: 0;
