  .no-js-note {
    margin-top: var(--space-5);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--color-paper);
    font-size: 0.9375rem;
  }

  /* ---- Fields -------------------------------------------------------------- */

  .field-grid {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  @media (width >= 34rem) {
