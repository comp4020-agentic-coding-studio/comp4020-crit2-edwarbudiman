    max-width: 30ch;
  }

  .book-notice__body {
    margin-top: var(--space-3);
    max-width: 62ch;
  }

  .book-notice a {
    color: var(--color-paper);
    text-decoration-color: var(--color-on-red-muted);
  }

  .book-notice a:hover {
    color: var(--color-on-red-muted);
  }

  /* ---- Body layout --------------------------------------------------------- */

  .book-body {
    display: grid;
    gap: var(--space-10);
    align-items: start;
    padding-bottom: var(--space-6);
  }

  @media (width >= 62rem) {
    .book-body {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.85fr);
      gap: var(--space-10) var(--space-12);
    }

    /* The proof replaces the form in the same column, so the page does not
       reflow around it. */
    .booking-form,
    .book-confirm {
      grid-column: 1;
      grid-row: 1;
    }

    .book-aside {
      grid-column: 2;
      grid-row: 1;
    }
  }

  /* ---- The form sheet ------------------------------------------------------ */

  .booking-form {
    padding: clamp(var(--space-5), 3.5vw, var(--space-8));
    border-radius: var(--radius);
    background: var(--color-cream);
  }

  .form-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    margin-bottom: var(--space-3);
