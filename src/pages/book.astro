  }

  .field {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  /* Mono, uppercase and tracked: these label data, which is the one job the
     furniture voice is allowed to do. Set at 13px rather than the 11px
     furniture size, because a form label has to be read, not glanced at. */
  .field__label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .field__hint {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-ink-muted);
    max-width: 46ch;
