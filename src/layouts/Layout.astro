---
import "../styles/global.css";
import kitsuneLogo from "../assets/photos/inari-logo.webp";

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;

// aria-current matches the exact route, not a prefix — "/" must not also
// mark "/menu/" as current just because both start with the base path.
const isCurrent = (href: string) => path === href;

const navLinks = [
  { href: base, label: "Home" },
  { href: `${base}menu/`, label: "Menu" },
  { href: `${base}contact/`, label: "Contact" },
];
const bookHref = `${base}book/`;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <nav aria-label="Primary" class="primary-nav">
        <a class="brand-mark" href={base} aria-label="Inari — home">
          <img src={kitsuneLogo.src} alt="" width="40" height="40" />
          <span class="brand-name">Inari</span>
        </a>

        <ul class="nav-links">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <a
          class="book-cta"
          href={bookHref}
          aria-current={isCurrent(bookHref) ? "page" : undefined}
        >
          Book a Table
        </a>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-grid">
        <address>
          Canberra Centre, 148 Bunda St<br />
          (Ground Level, between Bunda Street and Scotts Crossing)<br />
          Canberra City ACT 2601
        </address>

        <p>
          <a href="mailto:hello@inari.restaurant">hello@inari.restaurant</a>
        </p>

        <p>
          Lunch is closed every day — dinner only: Mon–Thu 5–9pm, Fri
          5–9.30pm, Sat 5–9.30pm, Sun 5–9pm.
        </p>

        <p class="footer-socials">
          <a href="https://www.instagram.com/inari.restaurant/">Instagram</a>
          <span aria-hidden="true"> · </span>
          <a href="https://www.facebook.com/inari.cbr/">Facebook</a>
          <span aria-hidden="true"> · </span>
          <a href="https://inari.restaurant/">inari.restaurant</a>
        </p>
      </div>

      <p class="footer-legal">
        Photography courtesy of Inari, reproduced here with credit and not
        monetised. This is an unofficial student redesign project for
        COMP4020 and is not affiliated with Inari.
      </p>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -999px;
    top: 0;
    padding: var(--space-2) var(--space-3);
    background: var(--color-cream);
    color: var(--color-ink);
    border-radius: var(--radius);
    z-index: 100;
  }

  .skip-link:focus {
    left: var(--space-3);
    top: var(--space-3);
    outline: 3px solid var(--color-red);
    outline-offset: 2px;
  }

  .site-header {
    background: var(--color-ink);
    color: var(--color-white);
  }

  /* Rhythm has two distinct levels, not one gap reused everywhere: a
     generous seam between the three major groups (brand / links / CTA),
     and a tighter one inside the links group where the items are peers. */
  .primary-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-4) var(--space-4);
    max-width: 72rem;
    margin: 0 auto;
  }

  .brand-mark {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-white);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    margin-right: auto;
    transition: opacity 150ms ease-out;
  }

  .brand-mark:hover {
    opacity: 0.8;
  }

  .brand-mark img {
    display: block;
    border-radius: var(--radius);
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-functional);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .nav-links a,
  .book-cta {
    color: var(--color-white);
    text-decoration: none;
    transition: color 150ms ease-out, opacity 150ms ease-out;
  }

  .nav-links a {
    text-underline-offset: 0.2em;
  }

  .nav-links a:hover {
    color: var(--color-cream);
    text-decoration: underline;
  }

  .nav-links a[aria-current="page"] {
    text-decoration: underline;
  }

  /* Book a Table is the one link styled as a solid button, at every
     viewport, and it lives in the same flat nav row as everything else —
     the original hides its equivalent inside a hamburger at 390px
     (decision-context §11/§12; TASKS.md 0.5), so there is deliberately no
     hamburger here for this to hide behind. */
  .book-cta {
    background: var(--color-red);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius);
    font-family: var(--font-functional);
    font-weight: 600;
    white-space: nowrap;
    transition: filter 150ms ease-out, transform 150ms ease-out;
  }

  .book-cta:hover {
    filter: brightness(1.12);
    transform: translateY(-1px);
  }

  .site-footer {
    background: var(--color-cream);
    color: var(--color-ink);
    padding: var(--space-8) var(--space-4);
    font-family: var(--font-functional);
  }

  .footer-grid {
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    gap: var(--space-4);
  }

  address {
    font-style: normal;
  }

  .footer-legal {
    max-width: 72rem;
    margin: var(--space-6) auto 0;
    font-size: 0.875rem;
    opacity: 0.8;
  }
</style>
